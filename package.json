{
  "name": "supplyline",
  "private": true,
  "version": "0.233.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "site": "node web/scripts/assets.cjs && next dev web -p 3001",
    "gallery": "node tools/model-gallery.cjs",
    "wiki": "node tools/export-wiki.cjs",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "desktop": "vite build && electron .",
    "dist": "vite build && electron-builder --win --publish never",
    "dist:demo": "vite build && node tools/build-demo.cjs",
    "release": "vite build && electron-builder --win --publish always",
    "dist:mac": "vite build && electron-builder --mac --publish never"
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "phaser": "^4.2.1",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "electron": "^44.9.0",
    "electron-builder": "^26.15.3",
    "next": "^16.4.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  },
  "main": "electron/main.cjs",
  "description": "Supplyline: build a supply network across a 3D world",
  "author": "Probably Fine Studios",
  "build": {
    "appId": "com.probablyfinestudios.supplyline",
    "productName": "Supplyline",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "category": "public.app-category.simulation-games",
      "artifactName": "Supplyline-${version}-${arch}.${ext}",
      "identity": "-",
      "hardenedRuntime": false,
      "gatekeeperAssess": false
    },
    "dmg": {
      "title": "Supplyline ${version}"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "deleteAppDataOnUninstall": false
    },
    "publish": [
      {
        "provider": "github",
        "owner": "Chrisocal21",
        "repo": "supplyline",
        "releaseType": "release"
      }
    ]
  }
}
